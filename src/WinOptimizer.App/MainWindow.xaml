<Window x:Class="WinOptimizer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:WinOptimizer.ViewModels"
        xmlns:views="clr-namespace:WinOptimizer.Views"
        Title="WinOptimizer" Width="1440" Height="900" MinWidth="1020" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackground}"
        FontFamily="pack://application:,,,/WinOptimizer;component/Assets/Fonts/#Plus Jakarta Sans" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        SnapsToDevicePixels="True" AutomationProperties.Name="WinOptimizer system dashboard">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><views:OverviewView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HardwareViewModel}"><views:HardwareView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PerformanceViewModel}"><views:PerformanceView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:OptimizeViewModel}"><views:OptimizeView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:StartupViewModel}"><views:StartupView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:StorageViewModel}"><views:StorageView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
  </Window.Resources>

  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="238" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False">
          <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" Margin="0,0,9,0" />
          <TextBlock Text="WINOPTIMIZER" Foreground="{DynamicResource TextPrimary}" FontSize="10" FontWeight="SemiBold" />
          <TextBlock Text="  /  SYSTEM INSIGHT" Foreground="{DynamicResource TextMuted}" FontSize="9" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Width="46" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMuted}" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" ToolTip="Minimize" AutomationProperties.Name="Minimize window" Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
          <Button Width="46" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMuted}" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" ToolTip="Maximize" AutomationProperties.Name="Maximize or restore window" Click="Maximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
          <Button Width="46" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMuted}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" ToolTip="Close" AutomationProperties.Name="Close window" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <Grid Margin="17,20,17,16">
        <Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
          <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
            <Grid><Ellipse Width="20" Height="20" Stroke="{DynamicResource Accent}" StrokeThickness="1.6" /><Ellipse Width="5" Height="5" Fill="{DynamicResource Accent}" /><Path Data="M8,6 L11,9 M18,6 L15,9 M8,18 L11,15 M18,18 L15,15" Stroke="{DynamicResource Accent}" StrokeThickness="1.4" /></Grid>
          </Border>
          <StackPanel Margin="11,1,0,0" VerticalAlignment="Center">
            <TextBlock Text="WINOPTIMIZER" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Bold" />
            <TextBlock Text="SYSTEM INSIGHT" Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="1,4,0,0" />
          </StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="WORKSPACE" Foreground="{DynamicResource TextMuted}" FontSize="9.5" FontWeight="SemiBold" Margin="10,0,0,9" />
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Navigation}" VerticalAlignment="Top">
          <ItemsControl.ItemTemplate><DataTemplate>
            <ToggleButton Style="{StaticResource NavItemStyle}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding Key}" AutomationProperties.Name="{Binding Label}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Grid.Row="4">
          <Border Style="{StaticResource CardStyle}" Padding="13" Margin="0,0,0,12">
            <StackPanel>
              <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" Margin="0,0,8,0" /><TextBlock Text="LOCAL MONITORING" Foreground="{DynamicResource TextPrimary}" FontSize="9.5" FontWeight="SemiBold" /></StackPanel>
              <TextBlock Text="No diagnostic data is uploaded." Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" FontSize="11" />
            </StackPanel>
          </Border>
          <Button Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left" Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="Open settings">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" /><TextBlock Text="Settings" FontSize="13" /></StackPanel>
          </Button>
          <TextBlock Text="v26.0.0 · preview" Style="{StaticResource MutedTextStyle}" Margin="12,10,0,0" FontSize="10" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1" Background="{DynamicResource AppBackground}">
      <Grid.RowDefinitions><RowDefinition Height="78" /><RowDefinition Height="1" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid Margin="34,0,34,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource PageHeadingStyle}" FontSize="21" />
          <TextBlock Text="{Binding CurrentPage.Subtitle}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,13,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="0,0,8,0" />
              <StackPanel>
                <TextBlock Text="{Binding MonitoringStatus}" Foreground="{DynamicResource TextPrimary}" FontSize="10.5" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding LastUpdateText}" Style="{StaticResource MutedTextStyle}" FontSize="9.5" HorizontalAlignment="Right" Margin="0,2,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}" Padding="11,9" ToolTip="Sample Windows measurements now" AutomationProperties.Name="Refresh measurements">
            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
          </Button>
          <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenSettingsCommand}" Padding="11,9" Margin="8,0,0,0" ToolTip="Settings" AutomationProperties.Name="Open settings">
            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
          </Button>
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="{DynamicResource Line}" />
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="34,24,34,36">
        <ContentControl Content="{Binding CurrentPage}" HorizontalContentAlignment="Stretch" />
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>

