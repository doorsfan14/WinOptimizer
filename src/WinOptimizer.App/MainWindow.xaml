<Window x:Class="WinOptimizer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinOptimizer.ViewModels"
        xmlns:views="clr-namespace:WinOptimizer.Views"
        Title="WinOptimizer" Width="1440" Height="900" MinWidth="1020" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackground}"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        SnapsToDevicePixels="True" AutomationProperties.Name="WinOptimizer system dashboard">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><views:OverviewView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HardwareViewModel}"><views:HardwareView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PerformanceViewModel}"><views:PerformanceView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:OptimizeViewModel}"><views:OptimizeView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:StartupViewModel}"><views:StartupView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:StorageViewModel}"><views:StorageView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    <Style x:Key="NavItemStyle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="13,11" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="navBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="navBorder" Property="Background" Value="{DynamicResource SurfaceRaised}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="navBorder" Property="Background" Value="{DynamicResource SidebarActive}" /><Setter TargetName="navBorder" Property="BorderBrush" Value="{DynamicResource Accent}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="navBorder" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="#08211E" /><Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="16,10" />
      <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="buttonBorder" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="buttonBorder" Property="Opacity" Value="0.88" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="buttonBorder" Property="Opacity" Value="0.72" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="buttonBorder" Property="Opacity" Value="0.42" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="buttonBorder" Property="BorderBrush" Value="{DynamicResource TextPrimary}" /><Setter TargetName="buttonBorder" Property="BorderThickness" Value="2" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    </Style>
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="PageHeadingStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="FontSize" Value="25" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" /><Setter Property="FontSize" Value="12.5" /><Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,5" /><Setter Property="FontSize" Value="11.5" />
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="Padding" Value="8,6" /><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceRaised}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SidebarActive}" /></Trigger></Style.Triggers></Style></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="238" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <Grid Margin="17,20,17,16">
        <Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
          <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
            <Grid><Ellipse Width="20" Height="20" Stroke="{DynamicResource Accent}" StrokeThickness="1.6" /><Ellipse Width="5" Height="5" Fill="{DynamicResource Accent}" /><Path Data="M8,6 L11,9 M18,6 L15,9 M8,18 L11,15 M18,18 L15,15" Stroke="{DynamicResource Accent}" StrokeThickness="1.4" /></Grid>
          </Border>
          <StackPanel Margin="11,1,0,0" VerticalAlignment="Center">
            <TextBlock Text="WINOPTIMIZER" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Bold" />
            <TextBlock Text="SYSTEM INSIGHT" Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="1,4,0,0" />
          </StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="WORKSPACE" Foreground="{DynamicResource TextMuted}" FontSize="9.5" FontWeight="SemiBold" Margin="10,0,0,9" />
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Navigation}" VerticalAlignment="Top">
          <ItemsControl.ItemTemplate><DataTemplate>
            <ToggleButton Style="{StaticResource NavItemStyle}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding Key}" AutomationProperties.Name="{Binding Label}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Grid.Row="4">
          <Border Style="{StaticResource CardStyle}" Padding="13" Margin="0,0,0,12">
            <StackPanel>
              <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" Margin="0,0,8,0" /><TextBlock Text="LOCAL MONITORING" Foreground="{DynamicResource TextPrimary}" FontSize="9.5" FontWeight="SemiBold" /></StackPanel>
              <TextBlock Text="No diagnostic data is uploaded." Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" FontSize="11" />
            </StackPanel>
          </Border>
          <Button Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left" Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="Open settings">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" /><TextBlock Text="Settings" FontSize="13" /></StackPanel>
          </Button>
          <TextBlock Text="v0.1 · in development" Style="{StaticResource MutedTextStyle}" Margin="12,10,0,0" FontSize="10" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Background="{DynamicResource AppBackground}">
      <Grid.RowDefinitions><RowDefinition Height="78" /><RowDefinition Height="1" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid Margin="34,0,34,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource PageHeadingStyle}" FontSize="21" />
          <TextBlock Text="{Binding CurrentPage.Subtitle}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
            <TextBlock Text="{Binding MonitoringStatus}" Foreground="{DynamicResource TextPrimary}" FontSize="11.5" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding LastUpdateText}" Style="{StaticResource MutedTextStyle}" FontSize="10.5" HorizontalAlignment="Right" Margin="0,3,0,0" />
          </StackPanel>
          <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}" Padding="11,9" ToolTip="Sample Windows measurements now" AutomationProperties.Name="Refresh measurements">
            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
          </Button>
          <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenSettingsCommand}" Padding="11,9" Margin="8,0,0,0" ToolTip="Settings" AutomationProperties.Name="Open settings">
            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
          </Button>
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="{DynamicResource Line}" />
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="34,24,34,36">
        <ContentControl Content="{Binding CurrentPage}" HorizontalContentAlignment="Stretch" />
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
