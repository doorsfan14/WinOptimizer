<UserControl x:Class="WinOptimizer.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WinOptimizer.Controls"
             AutomationProperties.Name="Hardware details">
  <StackPanel>
    <Border Style="{StaticResource CardStyle}" Padding="17" Margin="0,0,0,14">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="5" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Blue}" CornerRadius="2" />
        <StackPanel Grid.Column="2"><TextBlock Text="{Binding SensorStateText}" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="{Binding SensorMessage}" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" /></StackPanel>
      </Grid>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="0.95*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,12" MinHeight="205">
        <StackPanel>
          <TextBlock Text="Processor" Style="{StaticResource SectionHeadingStyle}" />
          <TextBlock Text="{Binding CpuModel}" Foreground="{DynamicResource TextPrimary}" FontSize="14" TextWrapping="Wrap" Margin="0,9,0,0" />
          <TextBlock Text="{Binding ProcessorCount}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
          <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Current frequency" Style="{StaticResource MutedTextStyle}" FontSize="10.5" /><TextBlock Text="{Binding CpuClock}" Foreground="{DynamicResource Blue}" FontSize="17" Margin="0,4,0,0" /></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="Temperature" Style="{StaticResource MutedTextStyle}" FontSize="10.5" /><TextBlock Text="{Binding CpuTemperature}" Foreground="{DynamicResource TextPrimary}" FontSize="17" Margin="0,4,0,0" /></StackPanel>
          </Grid>
          <TextBlock Text="{Binding CpuTemperatureSource}" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,8,0,0" />
          <TextBlock Text="Frequency changes with processor power management and workload. Temperature is a reported sensor reading, not a universal pass/fail limit." Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,12" MinHeight="205">
        <StackPanel>
          <TextBlock Text="Graphics devices" Style="{StaticResource SectionHeadingStyle}" />
          <ComboBox ItemsSource="{Binding Gpus}" SelectedItem="{Binding SelectedGpu}" DisplayMemberPath="Name" Margin="0,12,0,0" MinHeight="36" AutomationProperties.Name="Select graphics device" />
          <TextBlock Text="{Binding SelectedGpuDetail}" Foreground="{DynamicResource TextPrimary}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
          <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="Utilization" Style="{StaticResource MutedTextStyle}" FontSize="10" /><TextBlock Text="{Binding GpuUtilizationText}" Foreground="{DynamicResource TextPrimary}" FontSize="15" Margin="0,3,0,0" /></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="Temperature" Style="{StaticResource MutedTextStyle}" FontSize="10" /><TextBlock Text="{Binding GpuTemperatureText}" Foreground="{DynamicResource TextPrimary}" FontSize="15" Margin="0,3,0,0" /></StackPanel>
            <StackPanel Grid.Row="1" Margin="0,9,0,0"><TextBlock Text="Clock" Style="{StaticResource MutedTextStyle}" FontSize="10" /><TextBlock Text="{Binding GpuClockText}" Foreground="{DynamicResource TextPrimary}" FontSize="15" Margin="0,3,0,0" /></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,9,0,0"><TextBlock Text="Graphics memory" Style="{StaticResource MutedTextStyle}" FontSize="10" /><TextBlock Text="{Binding GpuMemoryText}" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,3,0,0" /></StackPanel>
          </Grid>
          <TextBlock Text="Each metric is checked independently. Integrated and dedicated graphics may expose different sensor sets." Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,12,0,0" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Padding="19" Margin="0,0,0,12">
        <StackPanel>
          <Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Cooling sensors" Style="{StaticResource SectionHeadingStyle}" /><TextBlock Text="Read only · no fan speed controls" Style="{StaticResource MutedTextStyle}" FontSize="10.5" Margin="0,3,0,0" /></StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Fans.Count, StringFormat={}{0} sensor(s)}" Foreground="{DynamicResource TextMuted}" FontSize="10.5" VerticalAlignment="Center" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Fans}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,5,0,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <controls:FanVisual Width="66" Height="66" Rpm="{Binding Rpm}" FanState="{Binding State}" AutomationProperties.Name="{Binding Name}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding HardwareName}" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,3,0,0" /><TextBlock Text="{Binding Source}" Style="{StaticResource MutedTextStyle}" FontSize="9.5" Margin="0,3,0,0" /></StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="{Binding RpmText}" Foreground="{DynamicResource TextPrimary}" FontSize="14" HorizontalAlignment="Right" /><TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedTextStyle}" FontSize="9.5" TextAlignment="Right" Margin="0,4,0,0" /></StackPanel>
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="No fan RPM sensor is available through the detected hardware interface. Firmware may not expose a usable reading; unavailable does not mean a fan has stopped." Margin="0,8,0,0">
            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasFans}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Padding="19">
        <StackPanel>
          <TextBlock Text="Storage devices" Style="{StaticResource SectionHeadingStyle}" />
          <TextBlock Text="Windows can report volume capacity and some device models. Drive health and solid-state classification are shown only when an explicit supported source is available." Style="{StaticResource MutedTextStyle}" Margin="0,4,0,10" />
          <ItemsControl ItemsSource="{Binding Snapshot.Drives}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Grid Margin="0,7,0,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Model, TargetNullValue=Model unavailable}" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="5,0" />
                <TextBlock Grid.Column="2" Text="{Binding MediaType, TargetNullValue=Media type not reported}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="8,0" />
                <TextBlock Grid.Column="3" Text="{Binding CapacityText}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" TextAlignment="Right" />
              </Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
  </StackPanel>
</UserControl>

