<UserControl x:Class="WinOptimizer.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Local optimization history">
  <StackPanel>
    <Border Style="{StaticResource CardStyle}" Padding="17" Margin="0,0,0,14">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="A local record of reviewed changes" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="The latest 300 events are stored in your Windows profile. Startup entries can be restored here; permanent file cleanup does not have an undo." Style="{StaticResource MutedTextStyle}" Margin="0,5,14,0" /></StackPanel>
        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="13,8" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <TextBlock Text="{Binding Status}" Style="{StaticResource MutedTextStyle}" Margin="2,0,0,10" />
    <ItemsControl ItemsSource="{Binding Items}">
      <ItemsControl.ItemTemplate><DataTemplate>
        <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,9">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="142" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Top"><TextBlock Text="{Binding Timestamp, StringFormat={}{0:MMM d, yyyy}}" Foreground="{DynamicResource TextPrimary}" FontSize="11" /><TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,3,0,0" /><TextBlock Text="{Binding Outcome}" Foreground="{DynamicResource Accent}" FontSize="9.5" Margin="0,5,0,0" /></StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextMuted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
            <Button Grid.Column="2" Content="{Binding UndoActionLabel}" Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" IsEnabled="{Binding CanUndo}" Style="{StaticResource SecondaryButtonStyle}" FontSize="9.5" Padding="9,7" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>

