<Window x:Class="WinOptimizer.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to WinOptimizer" Width="940" Height="650" MinWidth="850" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBackground}" FontFamily="pack://application:,,,/WinOptimizer;component/Assets/Fonts/#Plus Jakarta Sans" UseLayoutRounding="True">
  <Window.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /></Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="286" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <Grid Margin="25,27,25,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="36" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"><Grid><Ellipse Width="20" Height="20" Stroke="{DynamicResource Accent}" StrokeThickness="1.6" /><Ellipse Width="5" Height="5" Fill="{DynamicResource Accent}" /></Grid></Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="WINOPTIMIZER" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="Bold" /><TextBlock Text="FIRST-RUN SETUP" Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,4,0,0" /></StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="2" VerticalAlignment="Top">
          <TextBlock Text="GETTING STARTED" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,16" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,15"><Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"><TextBlock Text="1" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" /></Border><TextBlock Text="Welcome" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="11,0,0,0" FontSize="12" /></StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,15"><Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Line}" BorderThickness="1"><TextBlock Text="2" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" /></Border><TextBlock Text="Compatibility" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="11,0,0,0" FontSize="12" /></StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,15"><Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Line}" BorderThickness="1"><TextBlock Text="3" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" /></Border><TextBlock Text="Preferences" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="11,0,0,0" FontSize="12" /></StackPanel>
          <StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Line}" BorderThickness="1"><TextBlock Text="4" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" /></Border><TextBlock Text="Complete" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="11,0,0,0" FontSize="12" /></StackPanel>
        </StackPanel>
        <Border Grid.Row="3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="14">
          <StackPanel><TextBlock Text="PRIVATE BY DESIGN" Foreground="{DynamicResource Accent}" FontSize="9.5" FontWeight="Bold" /><TextBlock Text="Measurements and history stay in your Windows profile. WinOptimizer does not upload diagnostics." Foreground="{DynamicResource TextMuted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,7,0,0" /></StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="34,27,34,24">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding StepLabel}" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="SETUP · READ ONLY" Foreground="{DynamicResource TextMuted}" FontSize="9" VerticalAlignment="Center" /></Grid>
        <ProgressBar Height="3" Margin="0,12,0,0" Minimum="0" Maximum="3" Value="{Binding Stage, Mode=OneWay}" Background="{DynamicResource SurfaceRaised}" Foreground="{DynamicResource Accent}" BorderThickness="0" />
        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,25,0,0" />
        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextMuted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0" />
      </StackPanel>

      <Grid Grid.Row="1" Margin="0,22,0,20">
        <StackPanel Visibility="{Binding IsWelcome, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Border Style="{StaticResource CardStyle}" Padding="20">
            <StackPanel>
              <TextBlock Text="A calm, honest view of your system" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="See CPU and memory load, available disk space, processes, and the hardware sensors your PC actually provides." Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
              <Border Height="1" Background="{DynamicResource Line}" Margin="0,18,0,15" />
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="01" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" /><TextBlock Text="Measure" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,6,0,0" /><TextBlock Text="Use Windows data and supported sensors." Foreground="{DynamicResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,9,0" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="02" Foreground="{DynamicResource Blue}" FontSize="10" FontWeight="Bold" /><TextBlock Text="Explain" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,6,0,0" /><TextBlock Text="Show the context behind each reading." Foreground="{DynamicResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,9,0" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="03" Foreground="{DynamicResource Purple}" FontSize="10" FontWeight="Bold" /><TextBlock Text="Ask first" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,6,0,0" /><TextBlock Text="No automatic cleanup or startup changes." Foreground="{DynamicResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <TextBlock Text="WinOptimizer 26.0.0 is a preview release. Sensor coverage varies by PC; review its source and safety notes before use." Foreground="{DynamicResource TextMuted}" FontSize="10.5" TextWrapping="Wrap" Margin="2,13,0,0" />
        </StackPanel>

        <StackPanel Visibility="{Binding IsCompatibility, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Border Style="{StaticResource CardStyle}" Padding="19">
            <StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ProgressBar Width="42" Height="4" IsIndeterminate="True" Foreground="{DynamicResource Accent}" Background="{DynamicResource SurfaceRaised}" BorderThickness="0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" /><Ellipse Width="9" Height="9" Fill="{DynamicResource Accent}"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Grid.Column="1" Text="Windows compatibility and hardware discovery" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" /></Grid>
              <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0" />
              <TextBlock Text="{Binding CompatibilitySummary}" Foreground="{DynamicResource TextPrimary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,13,0,0" />
              <TextBlock Text="{Binding Capabilities.CpuName, TargetNullValue=Processor name unavailable}" Foreground="{DynamicResource Blue}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0" />
              <TextBlock Text="{Binding Capabilities.SensorSummary, TargetNullValue=No hardware scan has run yet}" Foreground="{DynamicResource TextMuted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
          <TextBlock Text="A standard Windows account is enough for normal CPU, memory, storage, and startup readings. Some low-level sensors can require vendor support or elevated access; unavailable readings remain blank." Foreground="{DynamicResource TextMuted}" FontSize="10.5" TextWrapping="Wrap" Margin="2,13,0,0" />
        </StackPanel>

        <StackPanel Visibility="{Binding IsPreferences, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Border Style="{StaticResource CardStyle}" Padding="19">
            <StackPanel>
              <TextBlock Text="Recommendation detail" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding LevelOptions}" SelectedItem="{Binding Level}" Margin="0,7,0,14" MinHeight="34" />
              <TextBlock Text="Theme" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" Margin="0,7,0,14" MinHeight="34" />
              <TextBlock Text="Monitoring interval · seconds" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding PollOptions}" SelectedItem="{Binding PollInterval}" Margin="0,7,0,0" MinHeight="34" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,12,0,0">
            <TextBlock Text="Recovery preparation: WinOptimizer backs up supported startup settings and keeps a local activity record. Temporary-file deletion cannot be undone. Windows restore points are not created automatically; create one in Windows before optional system-level changes." Foreground="{DynamicResource TextMuted}" FontSize="10.5" TextWrapping="Wrap" />
          </Border>
        </StackPanel>

        <StackPanel Visibility="{Binding IsComplete, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Border Style="{StaticResource CardStyle}" Padding="20">
            <StackPanel>
              <TextBlock Text="Your PC, as reported by Windows" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Findings}" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,0" />
              <Border Height="1" Background="{DynamicResource Line}" Margin="0,17,0,13" />
              <TextBlock Text="{Binding CompatibilitySummary}" Foreground="{DynamicResource TextPrimary}" FontSize="11.5" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Accent}" FontSize="10.5" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
          <TextBlock Text="No configuration was changed during setup. Review findings, hardware readings, and the process list from the overview." Foreground="{DynamicResource TextMuted}" FontSize="10.5" TextWrapping="Wrap" Margin="2,13,0,0" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Button Content="Back" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Padding="16,10" />
        <Button Grid.Column="1" Content="Skip for now" Command="{Binding SkipCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,9,0" Padding="16,10" />
        <Button Grid.Column="2" Content="{Binding NextLabel}" Command="{Binding NextCommand}" IsEnabled="{Binding IsNextEnabled}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="142" Padding="17,10" />
      </Grid>
    </Grid>
  </Grid>
</Window>

