<UserControl x:Class="WinOptimizer.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Storage capacity and cleanup">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /></UserControl.Resources>
  <StackPanel>
    <Border Style="{StaticResource CardStyle}" Padding="17" Margin="0,0,0,14">
      <StackPanel><TextBlock Text="Make space decisions with a preview" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Volumes show capacity and free space reported by Windows. WinOptimizer does not claim a drive is healthy based on capacity. Cleanup checks only older top-level temporary files in your Windows temporary folder." Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" /></StackPanel>
    </Border>
    <TextBlock Text="FIXED VOLUMES" Foreground="{DynamicResource TextMuted}" FontSize="9.5" FontWeight="SemiBold" Margin="3,0,0,8" />
    <ItemsControl ItemsSource="{Binding Drives}">
      <ItemsControl.ItemTemplate><DataTemplate>
        <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding FileSystem}" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,4,0,0" /><TextBlock Text="{Binding Model, TargetNullValue=Drive model unavailable}" Foreground="{DynamicResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,10,0" /></StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Capacity used" Foreground="{DynamicResource TextMuted}" FontSize="10.5" /><TextBlock Grid.Column="1" Text="{Binding UsedPercent, StringFormat={}{0:0}%}" Foreground="{DynamicResource TextPrimary}" FontSize="10.5" /></Grid>
              <ProgressBar Height="9" Margin="0,7,0,8" Maximum="100" Value="{Binding UsedPercent}" Background="{DynamicResource SurfaceRaised}" Foreground="{DynamicResource Accent}" BorderThickness="0" AutomationProperties.Name="Volume used capacity" />
              <TextBlock Text="{Binding CapacityText}" Foreground="{DynamicResource TextMuted}" FontSize="10.5" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="{Binding FreeText}" Foreground="{DynamicResource TextPrimary}" FontSize="16" HorizontalAlignment="Right" /><TextBlock Text="{Binding SpaceStatus}" Foreground="{DynamicResource Warning}" FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0" /></StackPanel>
          </Grid>
        </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="Windows has not reported a ready fixed volume yet." Margin="2,5,0,14">
      <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Drives.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>

    <Border Style="{StaticResource CardStyle}" Padding="19" Margin="0,5,0,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Temporary-file review" Style="{StaticResource SectionHeadingStyle}" /><TextBlock Text="A small, bounded scope with a file-by-file preview." Style="{StaticResource MutedTextStyle}" FontSize="10.5" Margin="0,4,0,0" /></StackPanel>
          <Button Grid.Column="1" Content="Scan eligible files" Command="{Binding PreviewCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,8,0" Padding="12,8" />
          <Button Grid.Column="2" Content="Remove reviewed files" Command="{Binding CleanCommand}" IsEnabled="{Binding PreviewReady}" Style="{StaticResource PrimaryButtonStyle}" Padding="13,8" />
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding Status}" Style="{StaticResource MutedTextStyle}" FontSize="10.5" TextWrapping="Wrap" Margin="0,12,0,0" />
        <TextBlock Grid.Row="2" Text="{Binding PreviewSummary}" Foreground="{DynamicResource Blue}" FontSize="11" Margin="0,9,0,0" Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <DataGrid Grid.Row="3" ItemsSource="{Binding Preview.Candidates}" MaxHeight="240" MinHeight="0" Margin="0,11,0,0" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Line}" Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" EnableRowVirtualization="True" Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Files eligible for cleanup">
          <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource SurfaceRaised}" /><Setter Property="Foreground" Value="{DynamicResource TextMuted}" /><Setter Property="Padding" Value="8,5" /><Setter Property="FontSize" Value="9.5" /></Style></DataGrid.ColumnHeaderStyle>
          <DataGrid.Columns><DataGridTextColumn Header="FILE PATH" Binding="{Binding Path}" Width="3*" /><DataGridTextColumn Header="SIZE" Binding="{Binding SizeText}" Width="100" /><DataGridTextColumn Header="LAST MODIFIED" Binding="{Binding LastWriteTime, StringFormat={}{0:g}}" Width="160" /></DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
