<UserControl x:Class="WinOptimizer.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WinOptimizer.Controls"
             AutomationProperties.Name="Performance measurements">
  <UserControl.Resources>
    <Style x:Key="ProcessGridStyle" TargetType="DataGrid">
      <Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="HeadersVisibility" Value="Column" /><Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" /><Setter Property="CanUserResizeRows" Value="False" />
      <Setter Property="IsReadOnly" Value="True" /><Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="RowHeight" Value="39" /><Setter Property="ColumnHeaderHeight" Value="35" />
      <Setter Property="EnableRowVirtualization" Value="True" /><Setter Property="EnableColumnVirtualization" Value="True" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="RowBackground" Value="{DynamicResource Surface}" /><Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceRaised}" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line}" />
      <Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource SurfaceRaised}" /><Setter Property="Foreground" Value="{DynamicResource TextMuted}" /><Setter Property="FontSize" Value="10.5" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="10,4" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="BorderThickness" Value="0,0,0,1" /></Style></Setter.Value></Setter>
      <Setter Property="CellStyle"><Setter.Value><Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,2" /><Setter Property="BorderThickness" Value="0" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SidebarActive}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Trigger></Style.Triggers></Style></Setter.Value></Setter>
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="17" Margin="0,0,7,12"><StackPanel><TextBlock Text="CPU utilization" Style="{StaticResource MutedTextStyle}" FontSize="10.5" /><TextBlock Text="{Binding CpuText}" Foreground="{DynamicResource TextPrimary}" FontSize="24" FontWeight="Light" Margin="0,5,0,0" /><TextBlock Text="Windows system time" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,4,0,0" /></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="17" Margin="7,0"><StackPanel><TextBlock Text="Physical memory" Style="{StaticResource MutedTextStyle}" FontSize="10.5" /><TextBlock Text="{Binding MemoryText}" Foreground="{DynamicResource TextPrimary}" FontSize="24" FontWeight="Light" Margin="0,5,0,0" /><TextBlock Text="Available RAM and in-use RAM" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,4,0,0" /></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="17" Margin="7,0,0,12"><StackPanel><TextBlock Text="Disk activity" Style="{StaticResource MutedTextStyle}" FontSize="10.5" /><TextBlock Text="{Binding DiskText}" Foreground="{DynamicResource TextPrimary}" FontSize="24" FontWeight="Light" Margin="0,5,0,0" /><TextBlock Text="System performance counter · may be unavailable" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,4,0,0" /></StackPanel></Border>
    </Grid>
    <Border Style="{StaticResource CardStyle}" Padding="19" Margin="0,0,0,12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="CPU history" Style="{StaticResource SectionHeadingStyle}" /><controls:HistoryChart Values="{Binding CpuHistory}" Stroke="{DynamicResource Accent}" Height="88" Margin="0,8,12,0" AutomationProperties.Name="CPU utilization history; use arrow keys when focused to inspect exact samples" /></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="Memory history" Style="{StaticResource SectionHeadingStyle}" /><controls:HistoryChart Values="{Binding MemoryHistory}" Stroke="{DynamicResource Blue}" Height="88" Margin="12,8,0,0" AutomationProperties.Name="Physical memory utilization history; use arrow keys when focused to inspect exact samples" /></StackPanel>
      </Grid>
    </Border>
    <Border Style="{StaticResource CardStyle}" Padding="18">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Processes using resources" Style="{StaticResource SectionHeadingStyle}" /><TextBlock Text="{Binding ProcessStatus}" Style="{StaticResource MutedTextStyle}" FontSize="10.5" Margin="0,4,12,0" /></StackPanel>
          <Button Grid.Column="1" Content="Refresh list" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" FontSize="11" />
        </Grid>
        <TextBlock Grid.Row="1" Text="CPU shows each process's share of total logical processor capacity over the last sample interval. Windows permissions can hide details for protected processes." Style="{StaticResource MutedTextStyle}" FontSize="10.5" Margin="0,12,0,9" />
        <DataGrid Grid.Row="2" ItemsSource="{Binding Processes}" Style="{StaticResource ProcessGridStyle}" MinHeight="190" MaxHeight="390" AutomationProperties.Name="Processes and their current resource use">
          <DataGrid.Columns>
            <DataGridTextColumn Header="PROCESS" Binding="{Binding Name}" Width="2*" />
            <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="90" />
            <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="100" />
            <DataGridTextColumn Header="WORKING SET" Binding="{Binding MemoryText}" Width="150" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>

