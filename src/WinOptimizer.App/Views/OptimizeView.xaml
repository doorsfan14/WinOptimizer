<UserControl x:Class="WinOptimizer.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="System recommendations and maintenance">
  <StackPanel>
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
          <TextBlock Text="SYSTEM CARE  /  EVIDENCE FIRST" Foreground="{DynamicResource Accent}" FontSize="9.5" FontWeight="Bold" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock Text="Make the right change." Foreground="{DynamicResource TextPrimary}" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Text="Every action below is tied to Windows measurements, your hardware, or a preview you can inspect." Style="{StaticResource MutedTextStyle}" Margin="0,5,20,0" />
      </StackPanel>
      <Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9" Padding="12,9" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="22" Height="22" CornerRadius="7" Background="{DynamicResource AccentSoft}" Margin="0,0,8,0"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <StackPanel><TextBlock Text="YOU STAY IN CONTROL" Foreground="{DynamicResource TextPrimary}" FontSize="9" FontWeight="SemiBold" /><TextBlock Text="No automatic changes" Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,3,0,0" /></StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Blue}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextPrimary}" FontSize="10.5" /><TextBlock Text="Usage, temperature, or fan speed alone is not treated as a fault. WinOptimizer does not disable security, stop protected processes, or apply hidden registry tweaks." Style="{StaticResource MutedTextStyle}" FontSize="9.5" Margin="0,3,0,0" /></StackPanel>
      </Grid>
    </Border>

    <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="OPTIMIZE ALL · GUIDED REVIEW" Foreground="{DynamicResource Accent}" FontSize="9" FontWeight="Bold" /><TextBlock Text="Bring every safe opportunity together." Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Text="Review current findings in one place. You approve each change separately; nothing is applied silently." Foreground="{DynamicResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,16,0" /></StackPanel>
        <Button Grid.Column="1" Content="Review all" Command="{Binding ReviewAllCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" Padding="18,10" AutomationProperties.Name="Review all available optimizations" />
      </Grid>
    </Border>

    <Grid Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,6,0"><StackPanel><TextBlock Text="WINDOWS FEATURES" Foreground="{DynamicResource Blue}" FontSize="9" FontWeight="Bold" /><TextBlock Text="Review optional components" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="Open Windows’ own feature manager. Disable only components you recognize; changes can affect apps and require a restart." Foreground="{DynamicResource TextMuted}" FontSize="9.5" TextWrapping="Wrap" Margin="0,4,0,9" /><Button Content="Open Windows Features" Command="{Binding WindowsFeaturesCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,7" AutomationProperties.Name="Open Windows optional features" /></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="14" Margin="6,0"><StackPanel><TextBlock Text="MEMORY PRESSURE" Foreground="{DynamicResource Blue}" FontSize="9" FontWeight="Bold" /><TextBlock Text="Understand what uses RAM" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="Windows reclaims cache when apps need memory. A cleaner that empties working sets often causes reloads and more disk use; inspect real process usage instead." Foreground="{DynamicResource TextMuted}" FontSize="9.5" TextWrapping="Wrap" Margin="0,4,0,9" /><Button Content="Review memory and processes" Command="{Binding ActionCommand}" CommandParameter="memory.pressure" Style="{StaticResource SecondaryButtonStyle}" Padding="10,7" /></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14" Margin="6,0,0,0"><StackPanel><TextBlock Text="OPTIONAL COMPANION TOOLS" Foreground="{DynamicResource Blue}" FontSize="9" FontWeight="Bold" /><TextBlock Text="From their official publishers" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold" Margin="0,7,0,0" /><WrapPanel Margin="0,9,0,0"><Button Content="Autoruns" Command="{Binding CompanionToolsCommand}" CommandParameter="autoruns" Style="{StaticResource SecondaryButtonStyle}" Padding="9,6" Margin="0,0,5,5" /><Button Content="Process Explorer" Command="{Binding CompanionToolsCommand}" CommandParameter="process-explorer" Style="{StaticResource SecondaryButtonStyle}" Padding="9,6" Margin="0,0,5,5" /><Button Content="WizTree" Command="{Binding CompanionToolsCommand}" CommandParameter="wiztree" Style="{StaticResource SecondaryButtonStyle}" Padding="9,6" Margin="0,0,5,5" /></WrapPanel><TextBlock Text="WinOptimizer never downloads or silently installs third-party software." Foreground="{DynamicResource TextMuted}" FontSize="9" TextWrapping="Wrap" /></StackPanel></Border>
    </Grid>

    <TextBlock Text="TOOLS THAT CAN MAKE A MEASURABLE DIFFERENCE" Foreground="{DynamicResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="2,0,0,9" />
    <Grid Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,7,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal"><Border Background="{DynamicResource AccentSoft}" CornerRadius="5" Padding="6,3"><TextBlock Text="DRIVE-AWARE" Foreground="{DynamicResource Accent}" FontSize="8.5" FontWeight="Bold" /></Border><TextBlock Text="WINDOWS NATIVE" Foreground="{DynamicResource TextMuted}" FontSize="8.5" VerticalAlignment="Center" Margin="9,0,0,0" /></StackPanel>
          <TextBlock Text="Optimize a drive" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="0,11,0,0" />
          <TextBlock Text="Ask Windows to run its built-in media-aware maintenance for one local volume. Windows selects the supported operation for that drive type; no files are removed." Style="{StaticResource MutedTextStyle}" FontSize="10.5" Margin="0,5,0,0" />
          <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" DisplayMemberPath="DriveOptionText" MinHeight="34" Margin="0,12,0,0" AutomationProperties.Name="Select a local drive for Windows maintenance" />
          <TextBlock Text="{Binding DriveStatus}" Foreground="{DynamicResource TextMuted}" FontSize="9.5" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
          <Button Content="Run Windows drive maintenance" Command="{Binding OptimizeDriveCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,11,0,0" Padding="12,9" />
          <TextBlock Text="Windows may request administrator approval. This uses disk activity, may take time, and has no undo; the Windows progress report is shown." Foreground="{DynamicResource TextMuted}" FontSize="9" TextWrapping="Wrap" Margin="0,7,0,0" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16" Margin="7,0,0,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal"><Border Background="{DynamicResource SidebarActive}" CornerRadius="5" Padding="6,3"><TextBlock Text="REVIEW FIRST" Foreground="{DynamicResource Blue}" FontSize="8.5" FontWeight="Bold" /></Border></StackPanel>
          <TextBlock Text="Take back control" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="0,11,0,0" />
          <TextBlock Text="Trim sign-in load or reclaim space only after seeing what will change." Style="{StaticResource MutedTextStyle}" FontSize="10.5" Margin="0,5,0,12" />
          <Button Content="Review startup apps" Command="{Binding ActionCommand}" CommandParameter="tool.startup" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Padding="12,9" />
          <Button Content="Preview temporary files" Command="{Binding ActionCommand}" CommandParameter="tool.cleanup" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Padding="12,9" />
          <TextBlock Text="Startup items are restored from History. Cleanup is limited to older top-level temporary files and is permanent." Foreground="{DynamicResource TextMuted}" FontSize="9" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Margin="2,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="Findings for this PC" Foreground="{DynamicResource TextPrimary}" FontSize="17" FontWeight="SemiBold" />
      <TextBlock Grid.Column="1" Text="LIVE CONTEXT · NO HEALTH SCORE" Foreground="{DynamicResource TextMuted}" FontSize="8.5" FontWeight="SemiBold" VerticalAlignment="Center" />
    </Grid>
    <ItemsControl ItemsSource="{Binding Recommendations}">
      <ItemsControl.ItemTemplate><DataTemplate>
        <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,9">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="3" Background="{DynamicResource Accent}" CornerRadius="2" Margin="0,0,13,0" />
            <StackPanel Grid.Column="1">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource AccentSoft}" CornerRadius="5" Padding="6,3"><TextBlock Text="{Binding Category}" Foreground="{DynamicResource Accent}" FontSize="8.5" FontWeight="SemiBold" /></Border>
                <TextBlock Grid.Column="1" Text="{Binding Confidence, StringFormat=EVIDENCE · {0}}" Foreground="{DynamicResource TextMuted}" FontSize="8.5" VerticalAlignment="Center" Margin="9,0,0,0" />
                <TextBlock Grid.Column="2" Text="{Binding Risk, StringFormat=RISK · {0}}" Foreground="{DynamicResource TextMuted}" FontSize="8.5" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,9,8,0" />
              <TextBlock Text="{Binding Explanation}" Foreground="{DynamicResource TextMuted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,10,0" />
              <TextBlock Text="{Binding ExpectedBenefit}" Foreground="{DynamicResource Blue}" FontSize="10" TextWrapping="Wrap" Margin="0,7,8,0" />
            </StackPanel>
            <Button Grid.Column="2" Content="{Binding ActionLabel}" Command="{Binding DataContext.ActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Id}" IsEnabled="{Binding HasAction}" Style="{StaticResource SecondaryButtonStyle}" Padding="11,8" Margin="10,0,0,0" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,3,0,0">
      <TextBlock Text="Drive maintenance follows Windows' media-aware /O behavior. It may use extra disk activity, and WinOptimizer records completion without claiming a speed increase. Power-plan changes are limited to confirmed AC power and can be restored from History." Foreground="{DynamicResource TextMuted}" FontSize="9.5" TextWrapping="Wrap" />
    </Border>
  </StackPanel>
</UserControl>

