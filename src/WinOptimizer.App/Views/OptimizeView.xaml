<UserControl x:Class="WinOptimizer.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="System recommendations">
  <StackPanel>
    <Border Style="{StaticResource CardStyle}" Padding="17" Margin="0,0,0,14">
      <StackPanel><TextBlock Text="Recommendations use observed conditions, not a universal score" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Each finding includes its evidence, expected benefit, confidence, and risk. WinOptimizer never applies a change automatically. The Safe, Balanced, and Advanced profiles adjust review thresholds; they do not enable speculative registry or service tweaks." Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" /></StackPanel>
    </Border>
    <TextBlock Text="{Binding Status}" Style="{StaticResource MutedTextStyle}" Margin="2,0,2,10" />
    <ItemsControl ItemsSource="{Binding Recommendations}">
      <ItemsControl.ItemTemplate><DataTemplate>
        <Border Style="{StaticResource CardStyle}" Padding="19" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="7,3"><TextBlock Text="{Binding Category}" Foreground="{DynamicResource Accent}" FontSize="9.5" FontWeight="SemiBold" /></Border>
                <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="{DynamicResource TextMuted}" FontSize="9.5" VerticalAlignment="Center" Margin="9,0,0,0" />
              </Grid>
              <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" />
              <TextBlock Text="{Binding Explanation}" Foreground="{DynamicResource TextMuted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,12,0" />
              <TextBlock Text="{Binding ExpectedBenefit}" Foreground="{DynamicResource Blue}" FontSize="11" TextWrapping="Wrap" Margin="0,9,12,0" />
              <StackPanel Orientation="Horizontal" Margin="0,9,0,0"><TextBlock Text="Confidence · " Foreground="{DynamicResource TextMuted}" FontSize="10" /><TextBlock Text="{Binding Confidence}" Foreground="{DynamicResource TextPrimary}" FontSize="10" /><TextBlock Text="    Risk · " Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="14,0,0,0" /><TextBlock Text="{Binding Risk}" Foreground="{DynamicResource TextPrimary}" FontSize="10" /></StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding ActionLabel}" Command="{Binding DataContext.ActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Id}" IsEnabled="{Binding HasAction}" Style="{StaticResource SecondaryButtonStyle}" Padding="13,8" Margin="12,0,0,0" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14">
      <TextBlock Text="Supported actions currently include reviewing and backing up current-user startup entries, plus a preview-first cleanup of older temporary files. Cleanup is permanent; startup changes can be restored from Startup or History." Foreground="{DynamicResource TextMuted}" FontSize="10.5" TextWrapping="Wrap" />
    </Border>
  </StackPanel>
</UserControl>
